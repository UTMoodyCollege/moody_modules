{% if layout == 'mosaic' %}
  {% if headline %}<h2>{{ headline }}</h2>{% endif %}
  <div class="moody-photo-mosaic gap-{{ gap }}">
    {% for item in items %}
      <figure class="moody-photo-mosaic__item size-{{ item.size }}">
        {% if item.link_url %}<a href="{{ item.link_url }}" aria-label="{{ item.headline ?: item.alt ?: 'View image'|t }}">{% endif %}
        <img src="{{ item.image_url }}" alt="{{ item.alt }}" loading="lazy">
        {% if item.link_url %}</a>{% endif %}
        {% if item.headline %}<figcaption>{{ item.headline }}</figcaption>{% endif %}
      </figure>
    {% endfor %}
  </div>
{% else %}
<div class="moody-image-grid-container ut-pt-8">
	<div class="container">
		{% if headline %}
			<div class="row">
				<div class="col-12">
					<div class="ut-text-3xl text-ut-white ut-font-weight-black text-center ut-pb-8">{{ headline }}</div>
				</div>
			</div>
		{% endif %}
		<div class="row">
			{% for item in items %}
				<div class="col-md-4">
					<div class="image-card-wrapper">
						<a href="{{ item.link_url }}" class="card" style="background-image: url('{{ item.image_url }}');">
							<div class="card-body">
								<h5 class="ut-text-2xl text-ut-white ut-font-weight-black text-center ut-p-2">{{ item.headline }}</h5>
							</div>
						</a>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</div>
{% endif %}
