<?php

/**
 * @file
 * Contains moody_subsite.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function moody_subsite_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the moody_subsite module.
    case 'help.page.moody_subsite':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Provide custom entity for Moody Subsite functionality') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function moody_subsite_theme() {
  return [
    'moody_subsite' => [
      'render element' => 'children',
    ],
    'moody_subsite_menu' => [
      'variables' => [
        'title' => NULL,
        'link' => NULL,
        'children' => [],
      ],
      'template' => 'moody-subsite-menu',
    ],
    'moody_info_bars' => [
      'variables' => [
        'title' => NULL,
        'link' => NULL,
      ],
      'template' => 'moody-info-bars',
    ],
    'field__moody_info_bars' => [
      'base hook' => 'field',
      'template' => 'field--moody-info-bars',
    ],
    'field__moody_subsite_menu' => [
      'base hook' => 'field',
      'template' => 'field--moody-subsite-menu',
    ],
  ];
}

/**
 * Implements hook_preprocess_field_multiple_value_form().
 */
function moody_subsite_preprocess_field_multiple_value_form(array &$variables) {
  if (($variables['element']['#field_name'] ?? '') !== 'subsite_nav' || empty($variables['table']['#rows'])) {
    return;
  }

  $variables['table']['#attributes']['class'][] = 'moody-subsite-menu-table';
  $variables['table']['#tabledrag'][] = [
    'action' => 'match',
    'relationship' => 'parent',
    'group' => 'subsite-menu-parent',
    'subgroup' => 'subsite-menu-parent',
    'source' => 'subsite-menu-id',
    'hidden' => FALSE,
    'limit' => 1,
  ];
  $variables['table']['#tabledrag'][] = [
    'action' => 'depth',
    'relationship' => 'group',
    'group' => 'subsite-menu-depth',
    'hidden' => FALSE,
  ];

  foreach ($variables['table']['#rows'] as &$row) {
    $item = &$row['data'][1]['data'];
    $depth = (int) ($item['is_child']['#value'] ?? $item['is_child']['#default_value'] ?? 0);
    $row['data'][0]['data'] = [
      '#theme' => 'indentation',
      '#size' => min(1, $depth),
    ];
    $row['data'][0]['class'][] = 'moody-subsite-menu-drag';
  }
  unset($row, $item);
}

/**
 * Implements hook_toolbar().
 */
function moody_subsite_toolbar() {
  $account = \Drupal::currentUser();
  $items['moody_subsites'] = [
    '#cache' => [
      'contexts' => ['user'],
      'tags' => ['moody_subsite_list', 'workbench_access_view', 'user:' . $account->id()],
    ],
  ];
  if (!in_array('moody_subsite_editor', $account->getRoles(), TRUE)) {
    return $items;
  }

  $resolver = \Drupal::service('moody_subsite.editor_context');
  $subsites = $resolver->assignedSubsites($account);
  if (!$subsites) {
    return $items;
  }

  $first = reset($subsites);
  $multiple = count($subsites) > 1;
  $items['moody_subsites'] += [
    '#type' => 'toolbar_item',
    'tab' => [
      '#type' => 'link',
      '#title' => $multiple ? t('My subsites') : t('My subsite'),
      '#url' => $first->toUrl('canonical'),
      '#attributes' => [
        'title' => $multiple
          ? t('View your assigned subsites')
          : t('View the @subsite dashboard', ['@subsite' => $resolver->label($first)]),
        'class' => ['toolbar-icon', 'toolbar-icon-system-admin-structure'],
      ],
    ],
    '#weight' => 101,
  ];

  if ($multiple) {
    $links = [];
    foreach ($subsites as $subsite) {
      $links['moody_subsite_' . $subsite->id()] = [
        'title' => $resolver->label($subsite),
        'url' => $subsite->toUrl('canonical'),
      ];
      $items['moody_subsites']['#cache']['tags'] = array_merge(
        $items['moody_subsites']['#cache']['tags'],
        $subsite->getCacheTags(),
      );
    }
    $items['moody_subsites']['tray'] = [
      '#heading' => t('Your assigned subsites'),
      'links' => [
        '#theme' => 'links__toolbar_user',
        '#links' => $links,
        '#attributes' => ['class' => ['toolbar-menu']],
      ],
    ];
  }
  else {
    $items['moody_subsites']['#cache']['tags'] = array_merge(
      $items['moody_subsites']['#cache']['tags'],
      $first->getCacheTags(),
    );
  }

  return $items;
}

/**
 * Adds subsite assignments to Moody AI's authoritative user context.
 */
function moody_subsite_moody_ai_user_capabilities_alter(array &$capabilities, AccountInterface $account) {
  $context = \Drupal::service('moody_subsite.editor_context')->collect($account);
  if ($context['active'] || !empty($context['manage_tool']['available'])) {
    $capabilities['subsites'] = $context;
  }
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function moody_subsite_moody_subsite_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  $term_ids = array_column($entity->get('directory_structure')->getValue(), 'target_id');
  $rows = [];
  $editor_ids = [];
  $editor_role_ids = [];
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  $date_formatter = \Drupal::service('date.formatter');
  $cacheability = (new CacheableMetadata())
    ->addCacheContexts(['user.permissions', 'user.node_grants:view', 'timezone'])
    ->addCacheTags(['node_list', 'node_type_list', 'user_list']);

  $account = \Drupal::currentUser();
  $update_access = $entity->access('update', $account, TRUE);
  $create_page_access = \Drupal::entityTypeManager()
    ->getAccessControlHandler('node')
    ->createAccess('moody_subsite_page', $account, [], TRUE);
  $cacheability
    ->addCacheableDependency($update_access)
    ->addCacheableDependency($create_page_access);

  if ($update_access->isAllowed()) {
    $build['editor_actions'] = [
      '#type' => 'container',
      '#weight' => -100,
      '#attributes' => [
        'class' => ['moody-subsite-editor-toolbar'],
        'aria-label' => t('Subsite editing tools'),
      ],
    ];
    $homepage = trim((string) $entity->get('base_url')->value);
    if (str_starts_with($homepage, '/')) {
      $build['editor_actions']['view_homepage'] = [
        '#type' => 'link',
        '#title' => t('View Homepage'),
        '#url' => Url::fromUserInput($homepage),
        '#attributes' => ['class' => ['button']],
      ];
    }
    if ($create_page_access->isAllowed()) {
      $build['editor_actions']['create_page'] = [
        '#type' => 'link',
        '#title' => t('Create subsite page'),
        '#url' => Url::fromRoute('node.add', ['node_type' => 'moody_subsite_page'], [
          'query' => ['moody_subsite' => $entity->id()],
        ]),
        '#attributes' => ['class' => ['button', 'button--primary']],
      ];
    }
    $build['editor_actions']['edit_navigation'] = [
      '#type' => 'link',
      '#title' => t('Edit navigation'),
      '#url' => $entity->toUrl('edit-form', [
        'query' => ['section' => 'menu'],
        'fragment' => 'subsite-navigation',
      ]),
      '#attributes' => ['class' => ['button']],
    ];
    $cacheability->applyTo($build['editor_actions']);
  }

  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($term_ids);
  $term_labels = [];
  foreach ($term_ids as $term_id) {
    if (isset($terms[$term_id])) {
      $term_labels[] = $terms[$term_id]->label();
      $cacheability->addCacheableDependency($terms[$term_id]);
    }
  }

  if ($term_ids && \Drupal::moduleHandler()->moduleExists('workbench_access')) {
    $scheme = \Drupal::entityTypeManager()->getStorage('access_scheme')->load('directory_structure');
    if ($scheme) {
      $user_section_storage = \Drupal::service('workbench_access.user_section_storage');
      $role_section_storage = \Drupal::service('workbench_access.role_section_storage');
      foreach ($term_ids as $term_id) {
        $editor_ids = array_merge($editor_ids, array_keys($user_section_storage->getEditors($scheme, $term_id)));
        $editor_role_ids = array_merge($editor_role_ids, $role_section_storage->getRoles($scheme, $term_id));
      }
      $cacheability
        ->addCacheableDependency($scheme)
        ->addCacheTags(['workbench_access_view']);
    }
  }

  $editor_role_ids = array_values(array_unique(array_filter($editor_role_ids)));
  $editor_roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple($editor_role_ids);
  $editor_role_labels = [];
  foreach ($editor_roles as $role) {
    $editor_role_labels[] = $role->label();
    $cacheability->addCacheableDependency($role);
  }

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  if ($editor_role_ids) {
    $editor_ids = array_merge($editor_ids, $user_storage->getQuery()
      ->condition('roles', $editor_role_ids, 'IN')
      ->accessCheck(FALSE)
      ->execute());
  }
  $editors = $user_storage->loadMultiple(array_unique(array_filter($editor_ids)));
  $editor_names = [];
  $active_editor_count = 0;
  foreach ($editors as $editor) {
    if ($editor->isActive()) {
      $active_editor_count++;
    }
    $editor_names[] = $editor->isActive()
      ? $editor->label()
      : t('@name (blocked)', ['@name' => $editor->label()]);
    $cacheability->addCacheableDependency($editor);
  }
  natcasesort($editor_names);
  natcasesort($editor_role_labels);

  $logo = ['#plain_text' => t('No custom logo.')];
  if ($logo_item = $entity->get('custom_logo')->first()) {
    $logo_value = $logo_item->getValue();
    $svg_logo_id = $logo_value['svg_logo'] ?? 0;
    $media_id = preg_replace('/^0,/', '', (string) ($logo_value['media'] ?? 0));
    $media_id = rtrim($media_id, ',');
    $logo = ['#plain_text' => t('The configured logo file is unavailable.')];
    if ($svg_logo_id && ($file = \Drupal::entityTypeManager()->getStorage('file')->load($svg_logo_id)) && file_exists($file->getFileUri())) {
      $logo = [
        '#theme' => 'image',
        '#uri' => $file->getFileUri(),
        '#alt' => $entity->label(),
      ];
      $cacheability->addCacheableDependency($file);
    }
    elseif ($media_id && $media = \Drupal::entityTypeManager()->getStorage('media')->load($media_id)) {
      if ($media->hasField('field_utexas_media_image') && $image_item = $media->get('field_utexas_media_image')->first()) {
        if (($file = $image_item->entity) && file_exists($file->getFileUri())) {
          $logo = [
            '#theme' => 'image_style',
            '#style_name' => 'utexas_image_style_1000w',
            '#uri' => $file->getFileUri(),
            '#alt' => $image_item->alt ?: $entity->label(),
          ];
          $cacheability
            ->addCacheableDependency($media)
            ->addCacheableDependency($file);
        }
      }
    }
  }

  if ($term_ids && isset($field_definitions['field_moody_url_generator'])) {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $node_ids = $node_storage->getQuery()
      ->condition('field_moody_url_generator.target_id', $term_ids, 'IN')
      ->sort('changed', 'DESC')
      ->accessCheck(TRUE)
      ->execute();
    $nodes = $node_storage->loadMultiple($node_ids);
    $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
    foreach ($node_ids as $node_id) {
      $node = $nodes[$node_id];
      $update_access = $node->access('update', NULL, TRUE);
      $operations = [
        'view' => [
          'title' => t('View'),
          'url' => $node->toUrl(),
        ],
      ];
      if ($update_access->isAllowed()) {
        $operations['edit'] = [
          'title' => t('Edit'),
          'url' => $node->toUrl('edit-form'),
        ];
      }

      $rows[] = [
        ['data' => $node->toLink()->toRenderable()],
        ['data' => ['#plain_text' => $bundle_info[$node->bundle()]['label'] ?? $node->bundle()]],
        ['data' => ['#plain_text' => $node->isPublished() ? t('Published') : t('Unpublished')]],
        ['data' => ['#plain_text' => $date_formatter->format($node->getChangedTime(), 'short')]],
        ['data' => ['#type' => 'operations', '#links' => $operations]],
      ];

      $cacheability
        ->addCacheableDependency($node)
        ->addCacheableDependency($update_access);
    }
  }

  $base_url = $entity->get('base_url')->value;
  $details = [
    'status' => [t('Status'), ['#plain_text' => $entity->isPublished() ? t('Published') : t('Unpublished')]],
    'homepage' => [t('Homepage'), $base_url ? [
      '#type' => 'link',
      '#title' => $base_url,
      '#url' => Url::fromUserInput($base_url),
    ] : ['#plain_text' => t('Not set')]],
    'sections' => [t('Directory sections'), ['#plain_text' => $term_labels ? implode(', ', $term_labels) : t('None')]],
    'created' => [t('Created'), ['#plain_text' => $date_formatter->format($entity->getCreatedTime(), 'short')]],
    'updated' => [t('Last updated'), ['#plain_text' => $date_formatter->format($entity->getChangedTime(), 'short')]],
    'owner' => [t('Owner'), ['#plain_text' => $entity->getOwner() ? $entity->getOwner()->label() : t('None')]],
    'content_count' => [t('Related content'), ['#plain_text' => count($rows)]],
    'editors' => [t('Editors'), ['#plain_text' => $editor_names ? t('@total total (@active active) — @names', [
      '@total' => count($editor_names),
      '@active' => $active_editor_count,
      '@names' => implode(', ', $editor_names),
    ]) : t('0 assigned')]],
    'editor_roles' => [t('Editor roles'), ['#plain_text' => $editor_role_labels ? implode(', ', $editor_role_labels) : t('None')]],
  ];
  $detail_list = [
    '#type' => 'html_tag',
    '#tag' => 'dl',
    '#attributes' => ['class' => ['moody-subsite-details']],
  ];
  foreach ($details as $key => [$label, $value]) {
    $detail_list[$key . '_label'] = [
      '#type' => 'html_tag',
      '#tag' => 'dt',
      '#value' => $label,
    ];
    $detail_list[$key . '_value'] = [
      '#type' => 'html_tag',
      '#tag' => 'dd',
      'value' => $value,
    ];
  }

  $build['overview'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['moody-subsite-overview']],
    '#attached' => ['library' => ['moody_subsite/subsite-admin']],
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Subsite overview'),
    ],
    'grid' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['moody-subsite-overview__grid']],
      'logo' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['moody-subsite-overview__logo']],
        'content' => $logo,
      ],
      'details' => $detail_list,
    ],
  ];
  $cacheability->applyTo($build['overview']);

  $build['related_content'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['moody-subsite-related-content']],
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Related content'),
    ],
    'table' => [
      '#type' => 'table',
      '#header' => [
        t('Title'),
        t('Content type'),
        t('Status'),
        t('Last updated'),
        t('Operations'),
      ],
      '#rows' => $rows,
      '#empty' => t('No related content found.'),
      '#attributes' => ['class' => ['responsive-enabled']],
    ],
  ];
  $cacheability->applyTo($build['related_content']);
}

/**
 * Implements hook_alter for the node form.
 */
function moody_subsite_form_node_form_alter(&$form, FormStateInterface &$form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  $subsite_id = (int) \Drupal::request()->query->get('moody_subsite', 0);
  if ($node->isNew() && $node->bundle() === 'moody_subsite_page' && $subsite_id && $node->hasField('field_moody_url_generator')) {
    $subsite = \Drupal::entityTypeManager()->getStorage('moody_subsite')->load($subsite_id);
    if ($subsite && $subsite->access('update')) {
      $term_ids = array_values(array_filter(array_map('intval', array_column($subsite->get('directory_structure')->getValue(), 'target_id'))));
      if ($term_ids && $node->get('field_moody_url_generator')->isEmpty()) {
        $term_id = $term_ids[0];
        $node->set('field_moody_url_generator', $term_id);
        if (isset($form['field_moody_url_generator']['widget'])) {
          $form['field_moody_url_generator']['widget']['#default_value'] = $term_id;
        }
        $form['moody_subsite_context'] = [
          '#type' => 'html_tag',
          '#tag' => 'div',
          '#value' => t('This page will be created in @subsite.', [
            '@subsite' => trim((string) $subsite->get('display_name')->value) ?: $subsite->label(),
          ]),
          '#attributes' => [
            'class' => ['messages', 'messages--status'],
            'role' => 'status',
          ],
          '#weight' => -20,
        ];
      }
    }
  }

  // Add a state to be invisible via Drupal form API to the $form['subsite_blog_summary'] if the subsite_page checkbox is not checked
  $invisible_state_for_blog_checked = [
    ':input[name="field_subsite_blog_page[value]"]' => ['checked' => FALSE],
  ];
  if (isset($form['field_subsite_blog_image'])) {
    $form['field_subsite_blog_image']['#states']['invisible'] = $invisible_state_for_blog_checked;
  }
  if (isset($form['field_subsite_blog_summary'])) {
    $form['field_subsite_blog_summary']['#states']['invisible'] = $invisible_state_for_blog_checked;
  }
}
