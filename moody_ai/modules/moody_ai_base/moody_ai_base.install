<?php

/**
 * @file
 * Install and update hooks for Moody AI Base.
 */

/**
 * Implements hook_schema().
 */
function moody_ai_base_schema() {
  $schema['moody_ai_assistant_usage_log'] = [
    'description' => 'Stores usage and outcome events for Moody AI features.',
    'fields' => [
      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'The user ID that made the request.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'thread_id' => [
        'description' => 'The AI chat thread ID, when available.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'target_entity_type' => [
        'description' => 'The target entity type.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'target_entity_id' => [
        'description' => 'The target entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'target_entity_label' => [
        'description' => 'The target entity label at request time.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'prompt' => [
        'description' => 'The user prompt. Never display or export this field in reports.',
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'tokens_used' => [
        'description' => 'The number of tracked AI usage tokens used by the request.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'status' => [
        'description' => 'The usage event status.',
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'success',
      ],
      'source' => [
        'description' => 'The Moody AI interface that initiated the request.',
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'assistant',
      ],
      'operation' => [
        'description' => 'The normalized operation performed by the request.',
        'type' => 'varchar_ascii',
        'length' => 48,
        'not null' => TRUE,
        'default' => '',
      ],
      'items_affected' => [
        'description' => 'The number of blocks, fragments, or other outcomes produced.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'request_count_hour' => [
        'description' => 'The user request count in the preceding hour, including this request.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 1,
      ],
      'needs_review' => [
        'description' => 'Whether automated signals marked the request for administrator review.',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'review_flags' => [
        'description' => 'Comma-separated automated review signal identifiers.',
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'created' => [
        'description' => 'Unix timestamp when the usage event was recorded.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'user_created' => ['uid', 'created'],
      'created' => ['created'],
      'entity' => ['target_entity_type', 'target_entity_id'],
      'status' => ['status'],
      'source_created' => ['source', 'created'],
      'operation_created' => ['operation', 'created'],
      'review_created' => ['needs_review', 'created'],
    ],
  ];

  return $schema;
}

/**
 * Migrates the original free-form context into the organized context config.
 */
function moody_ai_base_update_10001() {
  $config = \Drupal::configFactory()->getEditable('moody_ai_base.settings');
  $legacy = trim((string) $config->get('additional_context'));
  $editorial_design = trim((string) $config->get('context.editorial_design'));

  if ($legacy !== '' && $editorial_design === '') {
    $config->set('context.editorial_design', $legacy);
  }
  foreach (['site_identity', 'terminology', 'editorial_design'] as $key) {
    if ($config->get('context.' . $key) === NULL) {
      $config->set('context.' . $key, '');
    }
  }
  $config->clear('additional_context')->save(TRUE);

  return t('Migrated Moody AI site context to the organized shared context settings.');
}

/**
 * Moves shared AI usage reporting into the base module and adds outcomes.
 */
function moody_ai_base_update_10002() {
  $schema = \Drupal::database()->schema();
  $definition = moody_ai_base_schema()['moody_ai_assistant_usage_log'];
  if (!$schema->tableExists('moody_ai_assistant_usage_log')) {
    $schema->createTable('moody_ai_assistant_usage_log', $definition);
    return t('Created the shared Moody AI usage reporting table.');
  }

  foreach (['operation', 'items_affected'] as $field) {
    if (!$schema->fieldExists('moody_ai_assistant_usage_log', $field)) {
      $schema->addField('moody_ai_assistant_usage_log', $field, $definition['fields'][$field]);
    }
  }
  if (!$schema->indexExists('moody_ai_assistant_usage_log', 'operation_created')) {
    $schema->addIndex('moody_ai_assistant_usage_log', 'operation_created', ['operation', 'created'], $definition);
  }

  return t('Added shared Moody AI operation and outcome reporting.');
}

/**
 * Raises the default request limits while preserving custom values.
 */
function moody_ai_base_update_10003() {
  $config = \Drupal::configFactory()->getEditable('moody_ai_base.settings');
  if ($config->get('max_prompt_characters') === NULL || (int) $config->get('max_prompt_characters') === 2000) {
    $config->set('max_prompt_characters', 10000);
  }
  if ($config->get('max_output_tokens') === NULL || (int) $config->get('max_output_tokens') === 1800) {
    $config->set('max_output_tokens', 4000);
  }
  $config->save(TRUE);

  return t('Raised the default Moody AI prompt and output limits.');
}
