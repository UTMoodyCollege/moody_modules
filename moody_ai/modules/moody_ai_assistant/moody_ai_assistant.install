<?php

/**
 * @file
 * Install, update and uninstall functions for the Moody AI Assistant module.
 */

/**
 * Implements hook_schema().
 */
function moody_ai_assistant_schema() {
  $schema['moody_ai_assistant_user_budget'] = [
    'description' => 'Stores per-user AI token budgets.',
    'fields' => [
      'uid' => [
        'description' => 'The user ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'token_budget' => [
        'description' => 'The maximum number of AI usage tokens available to the user.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'tokens_used' => [
        'description' => 'The number of tracked AI usage tokens spent by the user.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'description' => 'Unix timestamp when the budget was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'description' => 'Unix timestamp when the budget was last changed.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['uid'],
    'indexes' => [
      'changed' => ['changed'],
    ],
  ];

  return $schema;
}
