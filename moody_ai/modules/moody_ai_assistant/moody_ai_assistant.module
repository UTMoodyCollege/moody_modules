<?php

declare(strict_types=1);

/**
 * @file
 * Theme hooks for the Moody AI Assistant module.
 */

/**
 * Implements hook_theme().
 */
function moody_ai_assistant_theme($existing, $type, $theme, $path): array {
  return [
    'moody_ai_assistant' => [
      'variables' => [
        'thread_id' => NULL,
        'messages' => [],
        'conversation_threads' => [],
        'form' => NULL,
        'entity_label' => NULL,
        'entity_type' => NULL,
        'entity_id' => NULL,
        'is_layout_builder_context' => FALSE,
        'widget_title_text' => 'Moody AI Assistant',
        'widget_bg_color' => '#bf5700',
        'widget_hover_color' => '#8f3d00',
      ],
      'template' => 'moody-ai-assistant',
    ],
  ];
}

/**
 * Implements hook_page_bottom().
 */
function moody_ai_assistant_page_bottom(array &$page_bottom): void {
  // The page already owns the global assistant. Injecting it into an AJAX
  // response or its modal iframe creates a second launcher inside dialogs.
  $request = \Drupal::request();
  $is_layout_builder_modal = $request->query->get('destination')
    === '/layout_builder_iframe_modal/redirect';
  if ($request->isXmlHttpRequest() || $is_layout_builder_modal) {
    return;
  }

  $account = \Drupal::currentUser();
  if (!$account->isAuthenticated() || !$account->hasPermission('use moody ai assistant')) {
    return;
  }

  /** @var \Drupal\Core\Block\BlockPluginInterface $assistant */
  $assistant = \Drupal::service('plugin.manager.block')->createInstance('moody_ai_assistant_block');
  if (!$assistant->access($account)) {
    return;
  }

  $page_bottom['moody_ai_assistant'] = $assistant->build();
}

/**
 * Implements hook_preprocess_block().
 */
function moody_ai_assistant_preprocess_block(array &$variables): void {
  $element = $variables['elements'] ?? [];
  $configuration = $element['#configuration'] ?? [];
  $plugin_id = (string) ($configuration['id'] ?? '');
  if (empty($element['#contextual_links']['layout_builder_block']) || (!in_array($plugin_id, ['moody_hero_builder', 'moody_card_builder'], TRUE) && (!str_starts_with($plugin_id, 'inline_block:') || empty($configuration['block_revision_id']) || !empty($configuration['block_serialized'])))) {
    return;
  }
  // Include newly added placements without rebuilding the assistant's picker.
  // These are presentation hints only; the server resolves and authorizes UUIDs.
  $variables['attributes']['data-ai-assistant-edit-block-type'] = in_array($plugin_id, ['moody_hero_builder', 'moody_card_builder'], TRUE) ? $plugin_id : substr($plugin_id, strlen('inline_block:'));
  $variables['attributes']['data-ai-assistant-edit-block-label'] = (string) ($configuration['label'] ?? t('Selected block'));
}
