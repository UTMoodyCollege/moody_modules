<?php

declare(strict_types=1);

/**
 * @file
 * Moody AI SEO hooks.
 */

/**
 * Implements hook_page_attachments().
 */
function moody_ai_seo_page_attachments(array &$attachments): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  $schema = \Drupal::service('moody_ai_seo.organization_schema')->build();
  if ($schema === []) {
    return;
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode(
        $schema,
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR,
      ),
      '#cache' => [
        'tags' => [
          'config:moody_ai_seo.settings',
          'config:system.site',
          'config:metatag.metatag_defaults.global',
        ],
        'contexts' => ['url.site'],
      ],
    ],
    'moody_ai_seo_organization',
  ];
}
