<?php

/**
 * @file
 * Install hooks for Moody Broken Links.
 */

/**
 * Implements hook_install().
 */
function moody_broken_links_install(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $storage->load('moody_broken_links_manager');
  if (!$role) {
    $role = $storage->create([
      'id' => 'moody_broken_links_manager',
      'label' => 'Moody Broken Links Manager',
      'weight' => 39,
    ]);
  }
  foreach ([
    'access administration pages',
    'administer moody broken links reports',
    'view the administration theme',
  ] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Implements hook_schema().
 */
